# SMS notifications (work order created/assigned/completed, comments) — best-effort,
# opt-in per user in profile settings. Uses a Twilio API Key (SK.../secret), not the
# primary Auth Token, so it's revocable independently of the main Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Random secret gating the /sms/inbound Twilio webhook (two-way SMS)
TWILIO_INBOUND_WEBHOOK_KEY=
# AI work order drafting (CLEO / MAX) — CriticalAsset's own served models, no
# third-party AI provider. Since the 2026-07-30 AWS cutover these are served
# from CriticalAsset's own AWS account behind a static bearer key, so AI
# drafting now works in LOCAL DEV too (the old GCP identity-token path only
# resolved on Cloud Run). Without the key /work-orders/ai-draft still returns
# {success: false} rather than crashing.
# Key value: s3://criticalasset-dr-archive/keys/aws-serve-api-key
EXPERT_MODELS_BASE_URL=https://experts.aws.criticalcopilot.com
CA_EXPERTS_KEY=
LDAP_ENABLED=false