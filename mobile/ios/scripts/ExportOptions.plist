<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Archive → App Store Connect (TestFlight) in one exportArchive step.
	     Signing is automatic/cloud via the ASC API key passed on the
	     command line (scripts/asc.env holds the ids; the .p8 lives in
	     ~/.appstoreconnect/private_keys, never in the repo). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>C7GCEESE2V</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
