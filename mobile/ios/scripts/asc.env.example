# Copy to scripts/asc.env (which is gitignored) and fill in.
# KEY_ID + ISSUER_ID come from the App Store Connect API key you created
# (Users & Access → Integrations → App Store Connect API). The matching
# private key must be at ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8.
# ASC_APP_ID is this app's numeric Apple ID (App Store Connect → App →
# App Information → General → "Apple ID"). For CriticalAsset Maintain it is
# 6794545308.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_APP_ID=6794545308
